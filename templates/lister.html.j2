{% if ajax %}
    {% extends 'ajaxBase.html.j2' %}
{% else %}
    {% extends 'base.html.j2' %}
    {% block title %}
    <title>{{ title }} {% if pagination.page_on!= 1 %}- Page {{ pagination.page_on }} {% endif %} - Faruzawa</title>
    {% endblock %}
    {% block meta %}
    {% if title == 'Popular' %}
    {% set meta_desc = "Browse popular anime on Faruzawa. See what others are watching and stream free in your browser." %}
    {% else %}
    {% set meta_desc = "Find the latest anime releases on Faruzawa. Pick a show, choose an episode, and watch free in your browser." %}
    {% endif %}
    {% if pagination.page_on != 1 %}
    {% set meta_desc = meta_desc ~ " Page " ~ pagination.page_on ~ "." %}
    {% endif %}
    <meta name="description" content="{{ meta_desc }}">
    <meta property="description" content="{{ meta_desc }}">
    <meta property="title" content="{{ title }}{% if pagination.page_on != 1 %} - Page {{ pagination.page_on }}{% endif %} - Faruzawa">
    <meta property="image" content="{{ base_url }}/static/media/Faruzan-Talent.png">
    <meta property="og:title" content="{{ title }} - Faruzawa">
    <meta property="og:description" content="{{ meta_desc }}">
    <meta property="og:image" content="{{ base_url }}/static/media/Faruzan-Talent.png">
    {% endblock %}
{% endif %} 
{% block content %}
<div class="container browse-page">
    {% if title %}
    <h1 class="browse-heading">{{ title }}</h1>
    {% endif %}
    <div class="pagination-top row">
        <div class="col-12">
            <nav aria-label="Anime Pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if pagination.page_on > 1 %}
                    <li class="page-item">
                        <a class="page-link" {% if ajax %}href="" data-value="?page=1"{% else %}href="?page=1"{% endif %} tabindex="-1" aria-disabled="true"><<</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" {% if ajax %}href="" data-value="?page={{ pagination.page_on - 1 }}"{% else %}href="?page={{ pagination.page_on - 1 }}"{% endif %} tabindex="-1" aria-disabled="true"><</a>
                    </li>
                    {% else %}
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true"><</a>
                    </li>
                    {% endif %}
                    {% for page_num in range(pagination.page_total - (4 if pagination.page_total > 4 else pagination.page_total-1), pagination.page_total + 1) %}
                    <li class="page-item {% if page_num == pagination.page_on %}active{% endif %}">
                        <a class="page-link" {% if ajax %}href="" data-value="?page={{ page_num }}"{% else %}href="?page={{ page_num }}"{% endif %}>{{ page_num }} {% if page_num == pagination.page_on %}{% endif %}</a>
                    </li>
                    {% endfor %}

                    {% if pagination.page_on < pagination.page_total %}
                    <li class="page-item">
                        <a class="page-link" {% if ajax %}href="" data-value="?page={{ pagination.page_on + 1 }}"{% else %}href="?page={{ pagination.page_on + 1 }}"{% endif %}>{{ ">" if not ajax else ">>" }}</a>
                    </li>
                    {% else %}
                    <li class="page-item disabled">
                        <a class="page-link" href="" tabindex="-1" aria-disabled="true">{{ ">" if not ajax else ">>" }}</a>
                    </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    </div>
    <div class="row browse-grid">
        {% for anime in data %}
        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            {% if title == 'New Releases' and anime.episode %}
            <a class="anime-card" href="/watch/{{ anime.raw_flair }}/episode-{{ anime.episode_raw }}">
            {% else %}
            <a class="anime-card" href="/watch/{{ anime.raw_flair }}">
            {% endif %}
                <span class="anime-card-media">
                    <img src="{{ cover_src(anime.cover) }}" alt="{{ anime.title_name }}">
                    {% if title == 'New Releases' and anime.episode %}
                    <span class="anime-card-badge">Ep {{ anime.episode }}</span>
                    {% endif %}
                </span>
                <span class="anime-card-body">
                    <span class="anime-card-title">{{ anime.title_name }}</span>
                    {% if title == 'New Releases' and anime.episode %}
                    <span class="anime-card-action">Watch</span>
                    {% else %}
                    <span class="anime-card-action">View</span>
                    {% endif %}
                </span>
            </a>
        </div>
        {% endfor %}
    </div>
    <div class="pagination-bottom row">
        <div class="col-12">
            <nav aria-label="Anime Pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if pagination.page_on > 1 %}
                    <li class="page-item">
                        <a class="page-link" {% if ajax %}href="" data-value="?page=1"{% else %}href="?page=1"{% endif %} tabindex="-1" aria-disabled="true"><<</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" {% if ajax %}href="" data-value="?page={{ pagination.page_on - 1 }}"{% else %}href="?page={{ pagination.page_on - 1 }}"{% endif %} tabindex="-1" aria-disabled="true"><</a>
                    </li>
                    {% else %}
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true"><</a>
                    </li>
                    {% endif %}
                    {% for page_num in range(pagination.page_total - (4 if pagination.page_total > 4 else pagination.page_total-1), pagination.page_total + 1) %}
                    <li class="page-item {% if page_num == pagination.page_on %}active{% endif %}">
                        <a class="page-link" {% if ajax %}href="" data-value="?page={{ page_num }}"{% else %}href="?page={{ page_num }}"{% endif %}>{{ page_num }} {% if page_num == pagination.page_on %}{% endif %}</a>
                    </li>
                    {% endfor %}

                    {% if pagination.page_on < pagination.page_total %}
                    <li class="page-item">
                        <a class="page-link" {% if ajax %}href="" data-value="?page={{ pagination.page_on + 1 }}"{% else %}href="?page={{ pagination.page_on + 1 }}"{% endif %}>{{ ">" if not ajax else ">>" }}</a>
                    </li>
                    {% else %}
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">{{ ">" if not ajax else ">>" }}</a>
                    </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    </div>
</div>  
<link rel="stylesheet" href="/static/css/sideElement.css">
{% endblock %}