<div id="episode-buttons" class="prewatch-episode-picker">
    {% set totalEpisodes = details.episodes %}
    {% set episodesPerGroup = 30 %}
    {% set numGroups = (totalEpisodes // episodesPerGroup) + (1 if totalEpisodes % episodesPerGroup != 0 else 0) %}
    <div class="episode-range-scroll" role="tablist" aria-label="Episode ranges">
        {% for group in range(numGroups) %}
        <button type="button" role="tab" class="grp-but{% if group == 0 %} active{% endif %}" id="group-{{ group }}-btn" aria-selected="{% if group == 0 %}true{% else %}false{% endif %}" aria-controls="group-{{ group }}" onclick="showGroup({{ group }})">{{ group * episodesPerGroup + 1 }}-{% if (group + 1) * episodesPerGroup < totalEpisodes %}{{ (group + 1) * episodesPerGroup }}{% else %}{{ totalEpisodes }}{% endif %}</button>
        {% endfor %}
    </div>
    <div id="episode-content" class="episode-content-wrapper">
        {% for group in range(numGroups) %}
        <div class="group-content{% if group == 0 %} active{% endif %}" role="tabpanel" id="group-{{ group }}" aria-labelledby="group-{{ group }}-btn">
            <div class="episode-grid">
                {% set startEpisode = group * episodesPerGroup + 1 %}
                {% set endEpisode = (group + 1) * episodesPerGroup %}
                {% for episode in range(startEpisode, endEpisode + 1) %}
                {% if episode <= totalEpisodes %}
                <button type="button" class="epi-but" onclick="redirectToEpisode('{{ details.episode_raw[episode-1] }}')">{{ details.episode_keys[episode-1] }}</button>
                {% endif %}
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>
