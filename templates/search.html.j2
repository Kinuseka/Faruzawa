{% extends 'base.html.j2' %}
{% block title %}
<title>Search - Faruzawa</title>
{% endblock %}
{% block meta %}
{% set meta_desc = "Search the Faruzawa catalog for anime to watch free in your browser." %}
<meta name="description" content="{{ meta_desc }}">
<meta property="description" content="{{ meta_desc }}">
<meta property="title" content="Search - Faruzawa">
<meta property="image" content="{{ base_url }}/static/media/Faruzan-Talent.png">
<meta property="og:title" content="Search - Faruzawa">
<meta property="og:description" content="{{ meta_desc }}">
<meta property="og:image" content="{{ base_url }}/static/media/Faruzan-Talent.png">
{% endblock %}
{% block content %}
<div class="container mt-5">
    <div class="header-search">
        <h1 class="header-title">Search</h1>
        <form class="search-form" id="searchForm" role="search" onsubmit="return false;">
            <label class="sr-only" for="searchInput">Search anime</label>
            <input type="search" id="searchInput" spellcheck="false" class="search-input" placeholder="Search anime…" autocomplete="off">
            <button type="submit" id="searchBtn" class="search-btn">Search</button>
        </form>
    </div>
    <main id="searchResults" class="search-results">
     <div class="header-preload">
        <h1>Search for content here</h1>
     </div>
    </main>
    <div id="loadingContainer" class="loading-container">
        <div id="loading" class="loading">
            <div class="loading-spinner"></div>
        </div>
        <div>
           
        </div>
    </div>
    <script src="/static/js/search.js"></script>
</div>
<link rel="stylesheet" href="/static/css/searchElement.css">
{% endblock %}
