<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block title %}
    <title>Faruzawa</title>
    {% endblock -%}
    {% block meta %}
    <meta property="title" content="Faruzawa">
    <meta property="image" content="{{ base_url }}/static/media/Faruzan-Talent.png">
    <meta property="description" content="Watch free contents here on Faruzawa!">
    <meta property="og:title" content="Faruzawa">
    <meta property="og:description" content="Watch free contents here on Faruzawa!">
    <meta property="og:image" content="{{ base_url }}/static/media/Faruzan-Talent.png">
    {% endblock %}
    <link rel="stylesheet" href="https://unpkg.com/swiper@7/swiper-bundle.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/colors.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>
<body>
    <header class="navbar sticky-top navbar-fixed-top">
        <a href="/" class="logo"><img class="logo-src" src="/static/original_icon.png" />Faruzawa</a>
        <nav class="navbar mobile-nav">
             <a href="{{'/' if request.path != '/' else '#'}}">Home</a>
             <a href="{{'/genre' if request.path != '/genre' else '#'}}">Genres</a>
             <a href="{{'/popular' if request.path != '/popular' else '#'}}">Popular</a>
             <a href="{{'/new' if request.path != '/new' else '#'}}">New</a>
             <div class="arrow fas fa-arrow-up" id="mobile-hide"></div>
        </nav>
        <div class="icons">
            <i class="fas fa-bars" id="menu-bars"></i>
            <a href="{{'/search.html' if request.path != '/search.html' else '#'}} " class="fa fa-search"></i>
            <a href="#" class="fas fa-heart"></a>
        </div>
    </header>
    <div class="content-padding"></div>
    {% block content %}
        <!-- Content specific to each page will go here -->
    {% endblock -%}
<div class="footer">
    <a href="/" class="logo"><img class="logo-src" src="/static/original_icon.png" />Faruzawa</a>
    <p id="text">{{ version_label }} - {{ version_num }}</p>
    <a href="/about" id="text">About us</a>
</div>
 <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer data-deferred="1"></script>  
 <script src="/static/js/main.js" defer data-deferred="1"></script>
</body>
</html>